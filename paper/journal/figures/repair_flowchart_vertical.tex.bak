\begin{figure}[t]
\centering
\begin{tikzpicture}[
  font=\scriptsize,
  node distance=2.5mm,
  >={Stealth[length=1.5mm,width=1.1mm]},
  every node/.style={align=center},
  box/.style={draw, rectangle, text width=0.62\columnwidth, inner sep=2.2pt, align=flush left},
  term/.style={draw, rectangle, rounded corners=2.4mm, text width=0.56\columnwidth, inner sep=2.2pt, minimum height=6mm},
  side/.style={draw, rectangle, rounded corners=2.4mm, text width=0.15\columnwidth, inner sep=2pt, minimum height=6mm},
  decision/.style={draw, diamond, aspect=3.4, inner sep=0.5pt, text width=0.31\columnwidth},
  flow/.style={draw, ->},
  lab/.style={font=\scriptsize\itshape},
]
\node[term] (start) {Trained teacher $T_0$, repair pool $\mathcal D_{\mathrm{rep}}$ (the training set) and target classes $\mathcal C_{\mathrm{tar}}$};

\node[box, below=of start] (s1) {\textbf{Step 1.} Evaluate $T_0$ on unaugmented images. Hard set $\mathcal H$: every target-class mistake, then the highest-NLL correct images, up to $\lceil\xi|I_c|\rceil$ per class. Preservation pool $\mathcal P$: the other correct images; $\mathcal P_{\mathrm{causal}}\subseteq\mathcal P$ holds an equal number per class.};

\node[box, below=of s1] (s2) {\textbf{Step 2.} For each hard image, take the $n_{\mathrm{comp}}$ correctly classified images of its class whose pooled last-stage features are most similar (its companions).\par\vspace{1.2mm}
{\centering
\begin{tabular}{@{}c@{\hspace{2mm}}c@{}}
\includegraphics[width=7.2mm]{figures/flow/hard.png} &
\includegraphics[width=7.2mm]{figures/flow/companion1.png}\hspace{0.7mm}%
\includegraphics[width=7.2mm]{figures/flow/companion2.png}\hspace{0.7mm}%
\includegraphics[width=7.2mm]{figures/flow/companion3.png}\hspace{0.7mm}%
\includegraphics[width=7.2mm]{figures/flow/companion4.png}\hspace{0.7mm}%
\includegraphics[width=7.2mm]{figures/flow/companion5.png} \\[-0.3mm]
hard image & companions
\end{tabular}\par}
\vspace{0.6mm}Example (CIFAR-10, $\rho=10$): a truck that $T_0$ labels an automobile with probability 0.94, and five trucks it classifies correctly.};

\node[box, below=of s2] (s3) {\textbf{Step 3.} Score each channel of the last two stages by $s=G\,D$, its margin gradient times its activation difference from the companions; normalize within each stage and average with equal class weight into $\overline s_a$. Keep the channels that rank in the top $\kappa$ fraction in at least $\pi_{\min}$ of $B_{\mathrm{boot}}$ bootstrap resamples ($\mathcal A_{\mathrm{stable}}$).};

\node[box, below=of s3] (s4) {\textbf{Step 4.} Zero each stable channel $a$ in turn. Retain it if the class-balanced hard-set margin rises and accuracy on $\mathcal P_{\mathrm{causal}}$ falls by at most $\eta_{\mathrm{acc}}$. Rank the $J$ retained channels by margin gain.};

\node[decision, below=3mm of s4] (d1) {Is $n_{\mathrm{edit}}\le J$ for some budget?};

\node[box, below=3mm of d1] (s5) {\textbf{Step 5.} For each feasible budget $n_{\mathrm{edit}}$ and learning rate, update only the parameters of the top $n_{\mathrm{edit}}$ channels to minimize $\mathcal L_{\mathrm{rep}}$ (hard-set cross-entropy plus output and feature preservation), then verify that no other parameter or buffer changed.};

\node[decision, below=3mm of s5] (d2) {Does a candidate raise validation $R_{\mathrm{tar}}$ and lose at most $\eta_{\mathrm{sel}}$ accuracy?};

\node[box, below=3mm of d2] (s6) {\textbf{Step 6.} Select the candidate with the highest validation $R_{\mathrm{tar}}$; break ties by lower $\operatorname{NLL}_{\mathrm{tar}}$, then the smaller budget, then the lower learning rate.};

\node[term, below=of s6] (end) {Distil the student from the returned teacher with Eq.~\eqref{eq:kd}};

\node[side, right=3mm of s5] (ret) {Return $T_0$ unchanged};

\draw[flow] (start) -- (s1);
\draw[flow] (s1) -- (s2);
\draw[flow] (s2) -- (s3);
\draw[flow] (s3) -- (s4);
\draw[flow] (s4) -- (d1);
\draw[flow] (d1) -- node[right, lab] {yes} (s5);
\draw[flow] (s5) -- (d2);
\draw[flow] (d2) -- node[right, lab] {yes} (s6);
\draw[flow] (s6) -- (end);
\draw[flow] (d1.east) -| node[pos=0.3, above, lab] {no} (ret.north);
\draw[flow] (d2.east) -| node[pos=0.3, below, lab] {no} (ret.south);
\draw[flow] (ret.east) -- ++(1.4mm,0) |- (end.east);
\draw[flow] ([yshift=-1.8mm]s4.west) -- ++(-2.2mm,0) |- node[pos=0.25, left, lab, rotate=90, anchor=south] {next $a$} ([yshift=1.8mm]s4.west);
\draw[flow] ([yshift=-3mm]s5.west) -- ++(-2.2mm,0) |- node[pos=0.25, left, lab, rotate=90, anchor=south] {next candidate} ([yshift=3mm]s5.west);
\end{tikzpicture}
\caption{Flowchart of the teacher repair procedure.}
\label{fig:repair-flow}
\end{figure}
